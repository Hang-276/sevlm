+class VisionZeroStageSwitcher:
+    """Stage switching for Vision-Zero (arXiv 2509.25541, App. A.2.3).
+
+    Upstream cycles the decision/clue stage on a fixed schedule
+    (`global_step % (interactive_cycle_length * 2)`). The paper instead switches on
+    smoothed statistics of the decision stage:
+
+        acc_bar <- RHO * acc_bar + (1 - RHO) * acc_t
+        na_bar  <- RHO * na_bar  + (1 - RHO) * na_t
+
+        decision -> clue:  acc_bar >= TAU_ACC_UP and na_bar <= TAU_NA_DOWN
+        clue -> decision:  (1 - acc_bar) >= TAU_ERR_UP or na_bar >= TAU_NA_UP
+
+    both gated by a minimum dwell time K_MIN, with the dwell counter reset on every
+    switch. b_s, b_civ, acc_bar and na_bar are never reset; the run starts in the
+    decision stage.
+
+    Table 5 also lists a patience P ("number of rounds before forcing change") that
+    the paper's pseudocode never references. PATIENCE below implements the literal
+    reading of Table 5 -- force a switch after P rounds without a threshold
+    trigger; None disables it.
+    """
+
+    RHO = 0.95
+    TAU_ACC_UP = 0.9
+    TAU_ERR_UP = 0.4
+    TAU_NA_UP = 0.5
+    TAU_NA_DOWN = 0.1
+    K_MIN = 5
+    PATIENCE = 20
+
+    def __init__(self, rho=None, tau_acc_up=None, tau_err_up=None, tau_na_up=None,
+                 tau_na_down=None, k_min=None, patience="default"):
+        if rho is not None:
+            self.RHO = rho
+        if tau_acc_up is not None:
+            self.TAU_ACC_UP = tau_acc_up
+        if tau_err_up is not None:
+            self.TAU_ERR_UP = tau_err_up
+        if tau_na_up is not None:
+            self.TAU_NA_UP = tau_na_up
+        if tau_na_down is not None:
+            self.TAU_NA_DOWN = tau_na_down
+        if k_min is not None:
+            self.K_MIN = k_min
+        if patience != "default":
+            self.PATIENCE = patience
+        self.stage = 0          # m: 0 = decision, 1 = clue
+        self.acc_bar = 0.0
+        self.na_bar = 0.0
+        self.dwell = 0          # d
+        self.updates = 0
+
+    def update(self, acc_t: float, na_t: float):
+        """Advance one iteration. Returns (stage, switched, reason)."""
+        self.acc_bar = self.RHO * self.acc_bar + (1.0 - self.RHO) * acc_t
+        self.na_bar = self.RHO * self.na_bar + (1.0 - self.RHO) * na_t
+        self.dwell += 1
+        self.updates += 1
+
+        switched = False
+        reason = ""
+        if self.dwell >= self.K_MIN:
+            if self.stage == 0:
+                if self.acc_bar >= self.TAU_ACC_UP and self.na_bar <= self.TAU_NA_DOWN:
+                    switched, reason = True, "acc_bar>=tau_acc_up and na_bar<=tau_na_down"
+            else:
+                if (1.0 - self.acc_bar) >= self.TAU_ERR_UP or self.na_bar >= self.TAU_NA_UP:
+                    switched, reason = True, "err_bar>=tau_err_up or na_bar>=tau_na_up"
+        if not switched and self.PATIENCE is not None and self.dwell >= self.PATIENCE:
+            switched, reason = True, "patience P=%s" % self.PATIENCE
+
+        if switched:
+            self.stage = 1 - self.stage
+            self.dwell = 0
+        return self.stage, switched, reason
+
+
