+    def _vz_stage_name(self) -> str:
+        return "clue" if self._vz_switcher.stage == 1 else "decision"
+
+    def _vz_update_stage(self):
+        """Advance the paper's stage switch, once per optimizer step.
+
+        `compute_loss` runs once per micro-batch, so the accumulators below are
+        filled `gradient_accumulation_steps` times per optimizer step while
+        `state.global_step` stays constant. Finalising when the step number
+        changes makes t -- the paper's iteration -- equal one optimizer step.
+        """
+        step = self.state.global_step
+        if self._vz_last_step is None:
+            self._vz_last_step = step
+            return
+        if step == self._vz_last_step:
+            return
+
+        n = max(1, self._vz_acc_n)
+        acc_t = self._vz_acc_sum / n
+        na_t = self._vz_na_sum / n
+        # Mirror apply_unified_role_advantage_adjustment: one mean-reduce per
+        # scalar, so every rank holds identical statistics and switches together.
+        device = self.accelerator.device
+        acc_t = self.accelerator.reduce(torch.tensor(acc_t, device=device), reduction="mean").item()
+        na_t = self.accelerator.reduce(torch.tensor(na_t, device=device), reduction="mean").item()
+
+        stage, switched, reason = self._vz_switcher.update(acc_t, na_t)
+        self._vz_last_step = step
+        self._vz_acc_sum = 0.0
+        self._vz_na_sum = 0.0
+        self._vz_acc_n = 0
+
+        self._metrics["vz_acc_t"].append(acc_t)
+        self._metrics["vz_na_t"].append(na_t)
+        self._metrics["vz_acc_bar"].append(self._vz_switcher.acc_bar)
+        self._metrics["vz_na_bar"].append(self._vz_switcher.na_bar)
+        self._metrics["vz_stage"].append(float(stage))
+        self._metrics["vz_dwell"].append(float(self._vz_switcher.dwell))
+
+        if self.accelerator.process_index == 0:
+            print(
+                f"[VZ SWITCH] step={step} micro_batches={n} acc_t={acc_t:.4f} na_t={na_t:.4f} "
+                f"acc_bar={self._vz_switcher.acc_bar:.4f} na_bar={self._vz_switcher.na_bar:.4f} "
+                f"dwell={self._vz_switcher.dwell} -> {self._vz_stage_name()}"
+                + (f"  SWITCHED ({reason})" if switched else "")
+            )
+
